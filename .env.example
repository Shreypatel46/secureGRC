# .env.example
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it is in .gitignore

# Eramba GRC Platform
ERAMBA_BASE_URL=https://localhost:9443
ERAMBA_USERNAME=admin
ERAMBA_PASSWORD=your_eramba_password_here

# NVD API (optional — increases rate limit from 5 to 50 req/30s)
# Register free at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here